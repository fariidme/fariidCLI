# ============================================================
#  Fariid Tech Security AI — environment configuration
#  Copy to `.env` and fill in your values. NEVER commit `.env`.
# ============================================================

# --- DeepSeek (primary provider) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Ollama (local models) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- OpenAI-compatible (any OpenAI-style endpoint) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- General ---
# passive | active | lab
FARIID_SEC_MODE=passive
# Optional: directory override for config/state
# FARIID_SEC_HOME=~/.config/fariid-sec
